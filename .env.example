# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# Email Settings
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=noreply@yourdomain.com

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blog_db
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_SSL=true

# JWT Secrets
JWT_ACCESS_SECRET=your_access_secret_32chars
JWT_REFRESH_SECRET=your_refresh_secret_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# GitHub Image Storage
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_image_repo_name
GITHUB_BRANCH=main

# jsDelivr CDN Base
JSDELIVR_BASE=https://cdn.jsdelivr.net/gh/your_github_username/your_image_repo_name@main

# Image Limits
MAX_IMAGE_SIZE_BYTES=5242880
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# Superadmin Seed Credentials
SUPERADMIN_EMAIL=admin@alltectamil.com
SUPERADMIN_PASSWORD=your_superadmin_secure_password
