### ==========================================
### AUTH & ADMIN ROUTES
### ==========================================

### 6. Admin Login
# @name login
POST {{baseUrl}}/admin/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

# RESPONSE:

# {
#   "success": true,
#   "status_code": 200,
